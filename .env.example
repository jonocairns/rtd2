# Model runtime (Vercel AI SDK)
# MODEL_PROVIDER can be "openai" or "anthropic".
# If omitted, the app uses OpenAI when OPENAI_API_KEY is set, otherwise Anthropic.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Overseerr / Seerr
OVERSEERR_URL=https://overseerr.example.com
OVERSEERR_API_KEY=

# Plex
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=

# mdblist
MDBLIST_API_KEY=

# Radarr (optional — enables radarr_replace_movie for re-grabbing bad releases)
RADARR_URL=http://radarr.local:7878
RADARR_API_KEY=

# Sonarr (optional — enables sonarr_replace for re-grabbing bad TV releases)
SONARR_URL=http://sonarr.local:8989
SONARR_API_KEY=
