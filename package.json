{
  "name": "media-agent",
  "version": "0.1.0",
  "description": "REPL toolkit agent for self-hosted media (Plex + Overseerr/Seerr + mdblist)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "evalite run",
    "eval:ui": "evalite serve"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "dotenv": "^16.4.0",
    "marked": "^14.0.0",
    "marked-terminal": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.0.0",
    "evalite": "^0.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  }
}
